# signal-desk configuration.
#
# NAMES AND DESCRIPTIONS ONLY. Never put a real credential in this file — it is
# committed. See docs/ENV-HANDBOOK.md for what each value does, where to get it,
# and which phase first needs it.
#
# Every variable below has a defined behaviour when absent. Phases 1-5 require no
# credentials at all. Run `pnpm check:env` to see what is configured and what is
# consequently degraded.

# ─── Mode ─────────────────────────────────────────────────────────────
DATA_MODE=MOCK              # MOCK | LIVE
AI_MODE=MOCK                # MOCK | LIVE
X_MODE=MOCK                 # MOCK | LIVE

# ─── Core ─────────────────────────────────────────────────────────────
DATABASE_URL=file:./data/signal-desk.db
LOG_LEVEL=info
TZ=Europe/Istanbul

# ─── Anthropic (required from Phase 6, LIVE only) ─────────────────────
ANTHROPIC_API_KEY=
AI_TRIAGE_MODEL=claude-haiku-4-5
AI_ANALYSIS_MODEL=claude-opus-5
AI_DAILY_BUDGET_USD=2.00
AI_ANALYSIS_THRESHOLD=70
AI_USE_BATCH_FOR_NON_URGENT=true

# ─── X (optional, Phase 12+; metered per request) ─────────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_DAILY_BUDGET_USD=0.50
X_ENABLE_POSTING=false
X_MAX_POSTS_PER_DAY=4

# ─── GitHub (optional — raises REST limit 60/h → 5000/h) ──────────────
GITHUB_TOKEN=

# ─── Dashboard (required once it is reachable off localhost) ──────────
# apps/web/src/proxy.ts refuses every request when the password is empty.
DASHBOARD_USER=operator
DASHBOARD_PASSWORD=

# ─── Alerts (optional) ────────────────────────────────────────────────
NTFY_TOPIC=
ALERT_MIN_PRIORITY=urgent
